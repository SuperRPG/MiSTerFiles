# CMake toolchain for MiSTer FPGA (DE10-Nano, Cortex-A9, ARMv7 hard-float)
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR armv7l)
set(CROSS arm-linux-gnueabihf-)
set(CMAKE_C_COMPILER   ${CROSS}gcc)
set(CMAKE_CXX_COMPILER ${CROSS}g++)
set(CMAKE_AR           ${CROSS}gcc-ar CACHE FILEPATH "")
set(CMAKE_RANLIB       ${CROSS}gcc-ranlib CACHE FILEPATH "")
set(MISTER_FLAGS "-mcpu=cortex-a9 -mfpu=neon -mfloat-abi=hard -O2")
set(CMAKE_C_FLAGS_INIT   "${MISTER_FLAGS}")
set(CMAKE_CXX_FLAGS_INIT "${MISTER_FLAGS}")
set(CMAKE_FIND_ROOT_PATH $ENV{MISTER_PREFIX})
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
